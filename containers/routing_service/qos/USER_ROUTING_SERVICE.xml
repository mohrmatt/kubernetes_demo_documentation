    <routing_service name="Kubernetes_To_External">
        <domain_route name="Kubernetes_To_External_Route">
            <participant name="1">
                <domain_id>0</domain_id>
                <participant_qos>
                    <discovery>
                        <initial_peers>
                            <element>rtps@udpv4://10.43.0.254:7400</element>
                        </initial_peers>
                    </discovery>
                </participant_qos>
            </participant>
            <participant name="2">
                <domain_id>1</domain_id>
                <participant_qos>
                    <transport_builtin>
                        <mask>UDPv4_WAN</mask>
                        <udpv4_wan>
                            <public_address>&lt;Static_Cluster_IP&gt;</public_address>
                            <comm_ports>
                                <default>
                                    <host>7800</host>
                                    <public>30007</public>
                                </default>
                            </comm_ports>
                        </udpv4_wan>
                    </transport_builtin>
                </participant_qos>
            </participant>

            <session name="Session">
                <auto_topic_route name="Forward">
                    <input participant="1">
                        <deny_topic_name_filter>rti/*</deny_topic_name_filter>
                        <creation_mode>IMMEDIATE</creation_mode>
                    </input>
                    <output participant="2">
                        <deny_topic_name_filter>rti/*</deny_topic_name_filter>
                        <creation_mode>IMMEDIATE</creation_mode>
                    </output>
                </auto_topic_route>
                <auto_topic_route name="Backward">
                    <input participant="2">
                        <creation_mode>IMMEDIATE</creation_mode>
                        <deny_topic_name_filter>rti/*</deny_topic_name_filter>
                    </input>
                    <output participant="1">
                        <creation_mode>IMMEDIATE</creation_mode>
                        <deny_topic_name_filter>rti/*</deny_topic_name_filter>
                    </output>
                </auto_topic_route>
            </session>
        </domain_route>
    </routing_service>

</dds>
